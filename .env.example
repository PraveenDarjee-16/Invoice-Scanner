# Copy this file to ".env" (NOT .env.local - the Prisma CLI only reads .env).
# Never commit the real .env file.

# --- PostgreSQL ------------------------------------------------------------
# Pooled/runtime connection string (used by the app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/invoice_scanner?sslmode=require"
# Direct (non-pooled) connection string, used by "prisma db push".
# If your provider has no separate pooled URL, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/invoice_scanner?sslmode=require"

# --- Sessions --------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- File storage (Vercel Blob, PRIVATE store) -----------------------------
# Added automatically when you connect a Blob store to the Vercel project.
# Locally, run "vercel env pull .env" or paste the token here.
# If left empty in development, files are kept in ./.local-storage instead.
BLOB_READ_WRITE_TOKEN=""

# --- First admin account ---------------------------------------------------
# Used by "npm run admin:create" and by the Vercel build. The account is created
# only if it does not exist yet. Remove ADMIN_PASSWORD from Vercel afterwards.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Set to "true" for ONE run to overwrite the password of an existing admin.
ADMIN_RESET_PASSWORD="false"
